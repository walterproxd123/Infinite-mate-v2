local ScreenGui = Instance.new("ScreenGui")
local Main = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local Close = Instance.new("TextButton")

local FreezeFrame = Instance.new("Frame")
local FreezeText = Instance.new("TextLabel")
local FreezeToggle = Instance.new("TextButton")
local FreezeCircle = Instance.new("Frame")

local AcceptFrame = Instance.new("Frame")
local AcceptText = Instance.new("TextLabel")
local AcceptToggle = Instance.new("TextButton")
local AcceptCircle = Instance.new("Frame")

-- Parent
ScreenGui.Parent = game.CoreGui

-- Main frame
Main.Parent = ScreenGui
Main.Size = UDim2.new(0, 260, 0, 140)
Main.Position = UDim2.new(0.5, -130, 0.5, -70)
Main.BackgroundColor3 = Color3.fromRGB(15, 20, 35)
Main.BorderSizePixel = 0
Main.Active = true
Main.Draggable = true

-- Bordes redondeados
local UICorner = Instance.new("UICorner", Main)
UICorner.CornerRadius = UDim.new(0, 12)

-- Título
Title.Parent = Main
